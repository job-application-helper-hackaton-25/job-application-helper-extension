{
  "manifest_version": 3,
  "name": "Job Offer Importer",
  "version": "0.1.0",
  "description": "Import job offer details from pages and send them to JobOffer API.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import Job Offer"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
